[meta]
name        = "Nord"
author      = "arcticicestudio"
mode        = "dark"
description = "An arctic, north-bluish color palette."

[terminal]
foreground = "#E5E9F0"
background = "#2E3440"
cursor = "#E5E9F0"
cursor-text = "#2E3440"
selection-foreground = "#2e3440"
selection-background = "#e5e9f0"
font-blending = "linear"
palette = [
    "#3B4252", "#BF616A", "#A3BE8C", "#EBCB8B",
    "#81A1C1", "#B48EAD", "#88C0D0", "#E5E9F0",
    "#4C566A", "#BF616A", "#A3BE8C", "#EBCB8B",
    "#81A1C1", "#B48EAD", "#8FBCBB", "#ECEFF4",
]

[cursor]
color = "#E5E9F0"
text = "#2E3440"

[cursor.block]
color = "#E5E9F0"
text = "#2E3440"

[cursor.bar]
color = "#88C0D0"

[cursor.underline]
color = "#88C0D0"

[token]
foreground = "#E5E9F0"
secondary = "#C0C7D3"
tertiary = "#7B8294"
accent = "#88C0D0"
success = "#A3BE8C"
warning = "#EBCB8B"
danger = "#BF616A"
hover-bg = "rgba(255,255,255,0.06)"
active-bg = "rgba(136,192,208,0.18)"
radius = 6
shadow = "0 8px 24px rgba(0,0,0,0.35)"
font-ui = ["-apple-system", "BlinkMacSystemFont", "SF Pro", "sans-serif"]
font-mono = ["JetBrains Mono", "SF Mono", "Menlo", "monospace"]
font-size = 13

[panel]
background = "#2E3440"
surface = "#3B4252"
border = "rgba(255,255,255,0.06)"

[window]
background = "#2E3440"
material = "none"
radius = 12

[window.unfocused]
opacity = 0.92

[titlebar]
foreground = "#C0C7D3"
font-size = 13
font-weight = 500
height = 40

[titlebar.unfocused]
foreground = "#7B8294"

[sidebar]
background = "#2E3440"
border-right = "1px solid #434C5E"
width = 220
material = "none"

[tab]
background = "transparent"
foreground = "#C0C7D3"
radius = 6
font-size = 13
font-weight = 400
padding = 10
indicator-color = "#7B8294"

[tab.hover]
background = "rgba(255,255,255,0.05)"

[tab.active]
background = "#3B4252"
foreground = "#ECEFF4"
font-weight = 500
shadow = "0 1px 2px rgba(0,0,0,0.25)"
indicator-color = "#88C0D0"

[tab.active.unfocused]
background = "#3B4252"
foreground = "#C0C7D3"
shadow = "none"

[tab-bar]
height = 36
padding = 8
border-bottom = "1px solid rgba(255,255,255,0.06)"

[tab-bar.tab]
radius = 8
height = 28

[container]
background = "#2E3440"
radius = 0
margin = 0
padding = 8

[divider]
color = "rgba(255,255,255,0.08)"
width = 1
