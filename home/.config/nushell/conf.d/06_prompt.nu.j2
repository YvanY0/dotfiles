# Disable welcome banner
$env.config.show_banner = false

# Nord palette
let nord = {
    nord0: '{{ visual.nord.nord0 }}'
    nord1: '{{ visual.nord.nord1 }}'
    nord2: '{{ visual.nord.nord2 }}'
    nord3: '{{ visual.nord.nord3 }}'
    nord4: '{{ visual.nord.nord4 }}'
    nord5: '{{ visual.nord.nord5 }}'
    nord6: '{{ visual.nord.nord6 }}'
    nord7: '{{ visual.nord.nord7 }}'
    nord8: '{{ visual.nord.nord8 }}'
    nord9: '{{ visual.nord.nord9 }}'
    nord10: '{{ visual.nord.nord10 }}'
    nord11: '{{ visual.nord.nord11 }}'
    nord12: '{{ visual.nord.nord12 }}'
    nord13: '{{ visual.nord.nord13 }}'
    nord14: '{{ visual.nord.nord14 }}'
    nord15: '{{ visual.nord.nord15 }}'
}

# Nord theme for nushell builtins and syntax shapes
$env.config.color_config = {
    binary: $nord.nord15
    block: $nord.nord9
    cell-path: $nord.nord5
    closure: $nord.nord8
    custom: $nord.nord7
    duration: $nord.nord13
    float: $nord.nord11
    glob: $nord.nord7
    int: $nord.nord15
    list: $nord.nord8
    nothing: $nord.nord11
    range: $nord.nord13
    record: $nord.nord8
    string: $nord.nord14

    # Dynamic values
    bool: {|| if $in { $nord.nord8 } else { $nord.nord13 } }
    datetime: {|| (date now) - $in |
        if $in < 1hr {
            { fg: $nord.nord11, attr: b }
        } else if $in < 6hr {
            $nord.nord11
        } else if $in < 1day {
            $nord.nord13
        } else if $in < 3day {
            $nord.nord14
        } else if $in < 1wk {
            { fg: $nord.nord14, attr: b }
        } else if $in < 6wk {
            $nord.nord8
        } else {
            $nord.nord9
        }
    }
    filesize: {|e|
        if $e == 0b {
            $nord.nord5
        } else if $e < 1mb {
            $nord.nord8
        } else {
            { fg: $nord.nord9 }
        }
    }

    # UI
    empty: $nord.nord9
    header: { fg: $nord.nord14, attr: b }
    hints: $nord.nord3
    leading_trailing_space_bg: { attr: n }
    row_index: { fg: $nord.nord14, attr: b }
    search_result: { fg: $nord.nord11, bg: $nord.nord5 }
    separator: $nord.nord5

    # Syntax shapes
    shape_and: { fg: $nord.nord15, attr: b }
    shape_binary: { fg: $nord.nord15, attr: b }
    shape_block: { fg: $nord.nord9, attr: b }
    shape_bool: $nord.nord8
    shape_closure: { fg: $nord.nord8, attr: b }
    shape_custom: $nord.nord14
    shape_datetime: { fg: $nord.nord8, attr: b }
    shape_directory: $nord.nord8
    shape_external: $nord.nord8
    shape_external_resolved: $nord.nord8
    shape_externalarg: { fg: $nord.nord14, attr: b }
    shape_filepath: $nord.nord8
    shape_flag: { fg: $nord.nord9, attr: b }
    shape_float: { fg: $nord.nord11, attr: b }
    shape_garbage: { fg: $nord.nord6, bg: $nord.nord11, attr: b }
    shape_glob_interpolation: { fg: $nord.nord8, attr: b }
    shape_globpattern: { fg: $nord.nord8, attr: b }
    shape_int: { fg: $nord.nord15, attr: b }
    shape_internalcall: { fg: $nord.nord8, attr: b }
    shape_keyword: { fg: $nord.nord15, attr: b }
    shape_list: { fg: $nord.nord8, attr: b }
    shape_literal: $nord.nord9
    shape_match_pattern: $nord.nord14
    shape_matching_brackets: { attr: u }
    shape_nothing: $nord.nord11
    shape_operator: $nord.nord13
    shape_or: { fg: $nord.nord15, attr: b }
    shape_pipe: { fg: $nord.nord15, attr: b }
    shape_range: { fg: $nord.nord13, attr: b }
    shape_raw_string: { fg: $nord.nord7, attr: b }
    shape_record: { fg: $nord.nord8, attr: b }
    shape_redirection: { fg: $nord.nord15, attr: b }
    shape_signature: { fg: $nord.nord14, attr: b }
    shape_string: $nord.nord14
    shape_string_interpolation: { fg: $nord.nord8, attr: b }
    shape_table: { fg: $nord.nord9, attr: b }
    shape_vardecl: { fg: $nord.nord9, attr: u }
    shape_variable: $nord.nord15
}

# Starship prompt
if (which starship | is-not-empty) {
    {% if os() == "linux" %}
    let starship_config = "pure.toml"
    {% else %}
    let starship_config = if ($env.TERM_PROGRAM? == "zed") { "pure.toml" } else { "starship.toml" }
    {% endif %}
    $env.STARSHIP_CONFIG = ($env.HOME | path join ".config" "starship" $starship_config)

    # Initialize starship and save to vendor autoload
    starship init nu | save -f ($nu.data-dir | path join "vendor/autoload/starship.nu")
}

# Vivid colors for ls (eza)
if (which vivid | is-not-empty) {
    $env.LS_COLORS = (vivid generate nord)
}
